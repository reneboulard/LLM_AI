<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LLM_AI</AssemblyName>
    <RootNamespace>LLM_AI</RootNamespace>
    <!-- L'hôte Emby de ce système tourne sur .NET 8 (System.Private.CoreLib 8.0,
         System.Memory 4.0.2.0). On cible net8.0 pour aligner les assemblies de
         référence : ReadOnlyMemory<char> (utilisé par ILogger de MediaBrowser.Model)
         provient du framework, sans paquet ni décalage de version.
         Un assembly net8.0 se charge normalement dans l'hôte .NET 8 d'Emby. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Version du plugin : BasePlugin.Version est sealed et renseignée par
         l'hôte Emby depuis la version de l'assembly au chargement. -->
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Model">
      <HintPath>libs/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>libs/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>libs/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Pages de configuration servies via IHasWebPages.GetPages() :
         HTML (lien dashboard) + module JS AMD lié par data-controller. -->
    <EmbeddedResource Include="config.html" />
    <EmbeddedResource Include="config.js" />
    <EmbeddedResource Include="recommendations.html" />
    <EmbeddedResource Include="recommendations.js" />
    <!-- Module i18n (FR/EN) : dictionnaires + walker DOM, dépendance
         __plugin/LLMAII18n des pages config et recommandations. -->
    <EmbeddedResource Include="i18n.js" />
    <!-- Image de la pastille du plugin (IHasThumbImage), servie sur
         /Plugins/{Id}/Thumb. 800x450 PNG 16:9. -->
    <EmbeddedResource Include="thumb.png" />
    <!-- Poster par défaut standardisé posé automatiquement (si manquant) sur la
         collection « AI Tonight » et la racine de la bibliothèque .strm.
         Lu via DefaultImageApplier.GetManifestResourceStream. JPEG portrait. -->
    <EmbeddedResource Include="default_poster.jpg" />
    <!-- Image de fond de la page Recommandations : module AMD exportant une
         data URI (ASCII). Servi sur web/ConfigurationPage?name=LLMAIBg.
         Nécessairement en texte (data URI) car cet endpoint lit les ressources
         en UTF-8 et corromprait un binaire. -->
    <EmbeddedResource Include="bg.js" />
    <!-- Vidéo de confirmation (10 s, 640x360, h264) renvoyée par l'endpoint
         /Plugins/LLMAI/Activate quand l'usager lit une carte .strm : crée le
         timer d'enregistrement puis stream ce clip. Binaire OK ici car servi
         par notre propre endpoint (Content-Type video/mp4), pas par la route
         UTF-8 ConfigurationPage. -->
    <EmbeddedResource Include="recording_activated.mp4" />
  </ItemGroup>
</Project>