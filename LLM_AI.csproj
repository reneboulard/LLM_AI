<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LLM_AI</AssemblyName>
    <RootNamespace>LLM_AI</RootNamespace>
    <!-- L'hôte Emby de ce système tourne sur .NET 8 (System.Private.CoreLib 8.0,
         System.Memory 4.0.2.0). On cible net8.0 pour aligner les assemblies de
         référence : ReadOnlyMemory<char> (utilisé par ILogger de MediaBrowser.Model)
         provient du framework, sans paquet ni décalage de version.
         Un assembly net8.0 se charge normalement dans l'hôte .NET 8 d'Emby. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Version du plugin : BasePlugin.Version est sealed et renseignée par
         l'hôte Emby depuis la version de l'assembly au chargement. -->
    <Version>1.1.5.0</Version>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Model">
      <HintPath>libs/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>libs/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>libs/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SkiaSharp : embarqué dans tout serveur Emby (Emby.Drawing.Skia l'utilise
         pour le redimensionnement des images ; la lib native est déjà chargée
         dans le processus hôte). Référence de compilation uniquement — au
         runtime, le plugin se lie à l'assembly fourni par l'hôte (même mécanisme
         que les DLL MediaBrowser.* ci-dessus). Sert au dessin du badge « AI »
         (AiBadgeEnhancer) — pas de dépendance externe à déployer. -->
    <Reference Include="SkiaSharp">
      <HintPath>libs/SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Pages de configuration servies via IHasWebPages.GetPages() :
         HTML (lien dashboard) + module JS AMD lié par data-controller. -->
    <EmbeddedResource Include="config.html" />
    <EmbeddedResource Include="config.js" />
    <EmbeddedResource Include="recommendations.html" />
    <EmbeddedResource Include="recommendations.js" />
    <EmbeddedResource Include="chat.html" />
    <EmbeddedResource Include="chat.js" />
    <!-- Module i18n (FR/EN) : dictionnaires + walker DOM, dépendance
         __plugin/LLMAII18n des pages config et recommandations. -->
    <EmbeddedResource Include="i18n.js" />
    <!-- Module de cache-busting : GÉNÉRÉ par la cible GenerateAssetVersionJs
         ci-dessous (template asset_version_template.js + $(Version)). Servi
         sur web/ConfigurationPage?name=LLMAIAssetVersion, chargé par les
         trois pages JS pour comparer la version du build servi à celle du
         serveur (GET /Plugins/LLMAI/Version) et auto-récupérer un JS
         périmé du cache disque. Ne pas committer le fichier généré. -->
    <EmbeddedResource Include="asset_version.js" />
    <!-- Image de la pastille du plugin (IHasThumbImage), servie sur
         /Plugins/{Id}/Thumb. 800x450 PNG 16:9. -->
    <EmbeddedResource Include="thumb.png" />
    <!-- Poster par défaut standardisé posé automatiquement (si manquant) sur la
         collection « AI Tonight » et la racine de la bibliothèque .strm.
         Lu via DefaultImageApplier.GetManifestResourceStream. JPEG portrait. -->
    <EmbeddedResource Include="default_poster.jpg" />
    <!-- Image de fond de la page Recommandations : module AMD exportant une
         data URI (ASCII). Servi sur web/ConfigurationPage?name=LLMAIBg.
         Nécessairement en texte (data URI) car cet endpoint lit les ressources
         en UTF-8 et corromprait un binaire. -->
    <EmbeddedResource Include="bg.js" />
    <!-- Vidéo de confirmation (10 s, 640x360, h264) renvoyée par l'endpoint
         /Plugins/LLMAI/Activate quand l'usager lit une carte .strm : crée le
         timer d'enregistrement puis stream ce clip. Binaire OK ici car servi
         par notre propre endpoint (Content-Type video/mp4), pas par la route
         UTF-8 ConfigurationPage. -->
    <EmbeddedResource Include="recording_activated.mp4" />
  </ItemGroup>

  <!-- Génération de asset_version.js (cache-busting client) : le template
       asset_version_template.js porte le marqueur __PLUGIN_VERSION__, remplacé
       par $(Version) du csproj — la version embarquée dans le JS ne peut donc
       JAMAIS dériver de celle de la DLL (le csproj fait partie des Inputs :
       un bump de <Version> régénère le module). Cible exécutée avant
       AssignTargetPaths (moment où les EmbeddedResource sont consommés) ;
       Inputs/Outputs la saute quand rien n'a changé → build incrémental
       (timestamp du fichier préservé). -->
  <Target Name="GenerateAssetVersionJs" BeforeTargets="AssignTargetPaths"
          Inputs="$(MSBuildProjectDirectory)/asset_version_template.js;$(MSBuildProjectFile)"
          Outputs="$(MSBuildProjectDirectory)/asset_version.js">
    <PropertyGroup>
      <_TemplatePath>$(MSBuildProjectDirectory)/asset_version_template.js</_TemplatePath>
      <_OutPath>$(MSBuildProjectDirectory)/asset_version.js</_OutPath>
      <_TemplateText>$([System.IO.File]::ReadAllText('$(_TemplatePath)'))</_TemplateText>
      <_GeneratedText>$([System.String]::Copy('$(_TemplateText)').Replace('__PLUGIN_VERSION__', '$(Version)'))</_GeneratedText>
    </PropertyGroup>
    <Error Condition="!Exists('$(_TemplatePath)')"
           Text="asset_version_template.js introuvable — nécessaire à la génération de asset_version.js." />
    <WriteLinesToFile File="$(_OutPath)"
                      Lines="$(_GeneratedText)"
                      Overwrite="true" />
  </Target>
</Project>