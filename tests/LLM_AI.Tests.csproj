<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests des fonctions pures du plugin.
       Lancer : dotnet test tests/LLM_AI.Tests.csproj
       Les paquets NuGet ci-dessous servent UNIQUEMENT à ce projet : la DLL du
       plugin reste sans dépendance NuGet. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>LLM_AI.Tests</AssemblyName>
    <RootNamespace>LLM_AI.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LLM_AI.csproj" />
    <!-- Assemblies de l'hôte Emby : compile-only dans le plugin (Private=false),
         mais nécessaires à l'exécution des tests (copiées localement ici). -->
    <Reference Include="MediaBrowser.Model"><HintPath>../libs/MediaBrowser.Model.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>../libs/MediaBrowser.Common.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>../libs/MediaBrowser.Controller.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>../libs/SkiaSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
