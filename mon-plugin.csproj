<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Version du plugin : BasePlugin.Version est sealed et renseignée par
         l'hôte Emby depuis la version de l'assembly au chargement. -->
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Model">
      <HintPath>/opt/emby-server/system/MediaBrowser.Model.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>/opt/emby-server/system/MediaBrowser.Common.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>/opt/emby-server/system/MediaBrowser.Controller.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
